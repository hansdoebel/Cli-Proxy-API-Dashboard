{
  "name": "cli-proxy-webui-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 VITE_MOCK_DEFAULT=1 vite",
    "build": "tsc && vite build",
    "build:mock": "tsc && VITE_MOCK=1 vite build",
    "preview": "vite preview",
    "test": "bun test",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "verify": "bun run test && bun run lint && bun run build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/merge": "^6.12.3",
    "@noble/hashes": "^2.4.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.5",
    "@uiw/react-codemirror": "^4.25.12",
    "axios": "1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.5.4",
    "lucide-react": "^1.79.0",
    "motion": "^12.42.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "overrides": {
    "form-data": "4.0.6"
  }
}
